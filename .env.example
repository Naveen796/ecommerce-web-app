# =====================================================================
# .env.example  ->  TEMPLATE FILE. Copy it to ".env" and edit the values.
#
#   Windows (PowerShell):   copy .env.example .env
#   macOS / Linux:          cp .env.example .env
#
# The real ".env" file is listed in .gitignore, so it is NEVER uploaded
# to GitHub. This keeps your database password safe.
# =====================================================================

# ---- Flask -------------------------------------------------------
# Generate a strong key with this command:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-long-random-string

# true  = show detailed error pages while developing
# false = hide them (use this when the site is live)
FLASK_DEBUG=true

# ---- MySQL -------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306

# Option A (recommended): the limited user created by database/schema.sql
DB_USER=ecommerce_user
DB_PASSWORD=Ecom@12345

# Option B: your own MySQL root account
# DB_USER=root
# DB_PASSWORD=your_mysql_password_here

DB_NAME=ecommerce_db

# ---- Website -----------------------------------------------------
SITE_NAME=ShopSphere
SITE_TAGLINE=Everyday essentials, delivered
CURRENCY=₹